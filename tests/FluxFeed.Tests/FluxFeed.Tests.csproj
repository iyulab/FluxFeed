<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- xUnit v3 test projects are stand-alone executables -->
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <!-- xunit.v3 with no Microsoft.NET.Test.Sdk (not
         required under Microsoft.Testing.Platform), coverlet.collector dropped (unused: CI
         never invoked collect against it). xunit.runner.visualstudio kept for IDE Test
         Explorer discovery. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- MTP equivalent of the ecosystem's VSTest blame-hang convention -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Iyu.Conventions.Testing" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <!-- README default stack (AddSQLiteVecVectorStore + AddFileVaultWithFluxIndex) exercised for real -->
    <PackageReference Include="FluxIndex.Storage.SQLite" />
    <!-- README C# blocks compiled against the current API; the Quick Start runs under a Generic Host -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FluxFeed\FluxFeed.csproj" />
  </ItemGroup>
</Project>
